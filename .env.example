# Copy to .env and fill in. Both are optional: without them the app runs fully offline
# (heuristic planner + local JSON store in storage/db).

# Gemini — lead investigator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_THINKING_LEVEL=high
# Seconds per Gemini call before that step falls back to the offline planner
GEMINI_TIMEOUT_S=120

# MongoDB Atlas — investigation memory. Run backend/scripts/setup_atlas.py once after setting this.
MONGODB_URI=
MONGODB_DB=cell_crime_scene
ATLAS_SEARCH_INDEX=ccs_search

# Hypothesis tournament: rounds, and competing candidates per round
MAX_ROUNDS=3
CANDIDATES_PER_ROUND=3
CORS_ORIGINS=http://localhost:3000
